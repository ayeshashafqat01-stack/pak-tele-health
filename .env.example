# Pak-Tele-Health Environment Configuration
# Copy to .env and fill in values

# ---- Database ----
# Supabase transaction pooler URL (port 6543) for application/serverless traffic.
# Preserve Supabase's SSL parameters and add `pgbouncer=true&connection_limit=1`.
DATABASE_URL="postgresql://pth_app:pth_dev_pass@localhost:5432/pak_tele_health?schema=public"

# Supabase direct/session URL (port 5432) for Prisma migrations and admin tooling.
DATABASE_MIGRATION_URL="postgresql://pth_app:pth_dev_pass@localhost:5432/pak_tele_health?schema=public"

# ---- Authentication ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_a_random_secret_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# ---- Application ----
NODE_ENV="development"
APP_TIMEZONE="Asia/Karachi"

# Set to "true" only for an intentional synthetic-data seed run; keep false on Vercel.
ALLOW_SEED="true"

# ---- Observability ----
LOG_LEVEL="info"
# Future: SENTRY_DSN, DATADOG_API_KEY, etc.

# ---- Security ----
# Rate limiting (requests per window)
RATE_LIMIT_LOGIN="5"
RATE_LIMIT_WINDOW_MS="900000"
