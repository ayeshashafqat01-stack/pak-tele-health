# Pak-Tele-Health Environment Configuration
# Copy to .env and fill in values

# ---- Database ----
# MySQL 8 connection string. Use utf8mb4 and UTC timezone.
DATABASE_URL="mysql://pth_app:change_me_app@localhost:3306/pak_tele_health?connection_limit=10&connect_timeout=10"

# Separate migration credentials with elevated permissions
DATABASE_MIGRATION_URL="mysql://pth_migrate:change_me_migrate@localhost:3306/pak_tele_health"

# ---- Authentication ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_a_random_secret_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# ---- Application ----
NODE_ENV="development"
APP_TIMEZONE="Asia/Karachi"

# Set to "true" ONLY in non-production to allow seed data operations
ALLOW_SEED="true"

# ---- Observability ----
LOG_LEVEL="info"
# Future: SENTRY_DSN, DATADOG_API_KEY, etc.

# ---- Security ----
# Rate limiting (requests per window)
RATE_LIMIT_LOGIN="5"
RATE_LIMIT_WINDOW_MS="900000"
